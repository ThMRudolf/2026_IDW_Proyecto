const { fetchWeather } = require('../services/openMeteo.service');

async function getWeatherData(req, res) {
  try {
    const lat = Number(req.query.lat);
    const lon = Number(req.query.lon);
    const cityName = String(req.query.name || 'Ubicación').trim();

    if (!Number.isFinite(lat) || !Number.isFinite(lon)) {
      return res.status(400).json({
        message: 'Los parámetros lat y lon son obligatorios y deben ser numéricos.'
      });
    }

    const data = await fetchWeather({ lat, lon, cityName });
    return res.status(200).json(data);
  } catch (error) {
    const status = error.statusCode || 500;
    return res.status(status).json({
      message: error.message || 'Error interno al consultar la API externa.'
    });
  }
}

module.exports = { getWeatherData };
